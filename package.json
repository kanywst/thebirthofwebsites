{
  "name": "thebirthofwebsites",
  "version": "2.0.0",
  "description": "A visual timeline of IT history.",
  "author": "kanywst",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.13.2",
    "simple-icons": "^16.28.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  }
}
